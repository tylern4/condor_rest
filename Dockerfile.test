ARG PYTHON_TAG=3.13-slim
FROM python:${PYTHON_TAG}

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

# Install dependencies before copying the sources so this layer is cached
# unless the dependency manifest changes. The project package is skipped on
# the first sync because `src/` is not present yet.
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --all-extras --dev --no-install-project

COPY src /app/src
COPY tests /app/tests
RUN uv sync --frozen --all-extras --dev

CMD ["uv", "run", "pytest", "-q"]
